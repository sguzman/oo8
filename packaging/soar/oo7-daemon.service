# One-time per-user service, to be installed as
# ~/.config/systemd/user/oo7-daemon.service
# This shadows Arch's vendor unit without modifying /usr/lib.
# No PAM change and no changes to your keyring files.
[Unit]
Description=Secret Service (oo8, Soar-managed)

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=%h/.local/share/soar/bin/oo8-daemon
Restart=on-failure
TimeoutStartSec=30s
TimeoutStopSec=30s
ImportCredential=oo7.keyring-encryption-password
StandardError=journal
# Use restrictions that can run in a non-root systemd --user manager.
# Kernel/module/device capability masks require user namespaces on some hosts
# and can prevent the service from starting (218/CAPABILITIES).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateNetwork=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
