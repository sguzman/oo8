# Maintained for oo8. Development snapshots: build/test before installing.
# The official oo7 package is replaced only if this package is explicitly installed.
pkgname=oo8
pkgver=0.7.0.alpha.r0.g901e740
pkgrel=1
pkgdesc='Independently maintained Secret Service provider (oo7-compatible)'
arch=('x86_64')
url='https://github.com/sguzman/oo8'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'rust')
provides=('oo7' 'org.freedesktop.secrets')
conflicts=('oo7' 'gnome-keyring')
source=('oo8::git+https://github.com/sguzman/oo8.git#branch=main')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/oo8"
  # A tagged GitHub Release becomes the Arch package version. Other commits
  # remain individually identifiable development snapshots.
  local release_tag
  release_tag="$(git tag --points-at HEAD --list 'v[0-9]*' | LC_ALL=C sort -V | tail -n 1)"
  if [[ -n "$release_tag" ]]; then
    printf '%s' "${release_tag#v}"
  else
    printf '0.7.0.alpha.r%s.g%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd "$srcdir/oo8"
  export CARGO_TARGET_DIR="$srcdir/cargo-target"
  cargo build --release --locked -p oo7-cli -p cargo-credential-oo7

  meson setup "$srcdir/build-server" server --prefix=/usr --libexecdir=lib -Dsystemd=enabled
  meson compile -C "$srcdir/build-server"

  meson setup "$srcdir/build-portal" portal --prefix=/usr --libexecdir=lib -Dsystemd=enabled
  meson compile -C "$srcdir/build-portal"

  meson setup "$srcdir/build-pam" pam --prefix=/usr --libexecdir=lib
  meson compile -C "$srcdir/build-pam"
}

package() {
  cd "$srcdir/oo8"
  meson install -C "$srcdir/build-server" --destdir "$pkgdir"
  meson install -C "$srcdir/build-portal" --destdir "$pkgdir"
  meson install -C "$srcdir/build-pam" --destdir "$pkgdir"

  install -Dm755 "$srcdir/cargo-target/release/oo7-cli" \
    "$pkgdir/usr/bin/oo7-cli"
  install -Dm755 "$srcdir/cargo-target/release/cargo-credential-oo7" \
    "$pkgdir/usr/bin/cargo-credential-oo7"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
